generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_POSTGRES_PRISMA_URL")
  directUrl = env("DATABASE_POSTGRES_URL_NON_POOLING")
}

model Employee {
  email         String  @id
  name          String
  department    String
  role          String
  walletAddress String  @unique
  did           String  @unique
}

model Asset {
  serialNumber   String  @id
  tokenId        Int     @unique
  name           String
  description    String
  assetType      String
  ownerEmail     String
  ownerDID       String
  isLocked       Boolean @default(true)
  warrantyExpiry String
  qrPayload      String
}

model WebhookLog {
  id             Int     @id @default(autoincrement())
  timestamp      String
  triggerType    String
  role           String
  userEmail      String
  actionExecuted String
  status         String
}

model Nonce {
  address String @id
  nonce   String
}

model MagicLink {
  id         String   @id @default(cuid())
  email      String
  name       String?
  department String?
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}
